{
  "expo": {
    "name": "EasyCook",
    "slug": "EasyCookApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.mattjoe.easycook"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.mattjoe.easycook",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "EasyCook uses your photos so you can add pictures of meals you loved.",
          "cameraPermission": "EasyCook uses the camera so you can snap meals you loved."
        }
      ],
      "expo-image",
      "expo-font"
    ],
    "scheme": "easycook",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "63bc3a02-eaa6-4682-a798-bef5e8ea7f09"
      }
    },
    "owner": "matthewjjoe"
  }
}
